# ====== Telegram (ruang kontrol) ======
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID Telegram Anda (angka). Kosongkan dulu, lalu kirim /start ke bot: bot akan memberi tahu ID Anda.
# Bisa lebih dari satu admin, pisahkan koma.
TELEGRAM_ADMIN_IDS=

# ====== Threads (Meta) App ======
# developers.facebook.com > App > Use cases > Access the Threads API > Customize > Settings
THREADS_APP_ID=
THREADS_APP_SECRET=
# Access token dari "User Token Generator". Boleh dikosongkan dan dikirim lewat Telegram: /token <token>
THREADS_ACCESS_TOKEN=

# ====== Claude (Anthropic) ======
ANTHROPIC_API_KEY=
# Model untuk post & riset tren (tulisan lebih berkualitas)
CLAUDE_MODEL_WRITER=claude-sonnet-5-5
# Model untuk balasan komentar & komentar ke post orang (lebih murah, volume tinggi)
CLAUDE_MODEL_REPLY=claude-haiku-5-5
# low | medium | high
CLAUDE_EFFORT=low

# ====== Perilaku bot ======
TIMEZONE=Asia/Jakarta
# true = tidak benar-benar posting ke Threads (uji coba). Ganti false kalau sudah yakin.
DRY_RUN=true
# true = draf harus disetujui di Telegram dulu sebelum terbit
REQUIRE_APPROVAL_POSTS=true
REQUIRE_APPROVAL_REPLIES=true
REQUIRE_APPROVAL_COMMENTS=true

# Jam auto-post (HH:MM, pisahkan koma)
POST_TIMES=08:00,12:30,19:30
MAX_POSTS_PER_DAY=3
MAX_REPLIES_PER_HOUR=20
MAX_COMMENTS_PER_DAY=10

# Interval (menit / jam)
REPLY_POLL_MINUTES=10
COMMENT_SCAN_MINUTES=120
RESEARCH_HOURS=6

AUTO_POST_ENABLED=true
AUTO_REPLY_ENABLED=true
# Komentar ke post orang lain butuh izin threads_keyword_search (lihat README)
AUTO_COMMENT_ENABLED=false
AUTO_RESEARCH_ENABLED=true

# Kata kunci niche untuk riset & mencari post untuk dikomentari (pisahkan koma)
NICHE_KEYWORDS=maklon skincare,maklon serum,bikin brand skincare,bisnis skincare,brand lokal
# Kode negara Google Trends
TRENDS_GEO=ID

DB_PATH=data/autothreads.db
PERSONA_FILE=persona.md
KNOWLEDGE_FILE=knowledge.md
